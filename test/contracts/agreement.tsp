import "@typespec/http";

using Http;

/**
 * The two emitted artefacts describing one operation's input.
 *
 * `schemas.gen.ts` declares the validators a server enforces, keyed as the wire names them.
 * `requests.gen.ts` declares the type a consumer's handler is checked against. Both are generated by
 * one program from one source, and nothing compared them: `wire-contract.gen.ts` pairs the validator
 * against the contract type for MODELS, and a merged input type is not a model.
 *
 * Every construct here is one where the two names can differ.
 */
@service(#{ title: "contract agreement" })
namespace ContractAgreement;

model Thing {
  id: string;
}

/** A header renamed on the wire. The validator keys `x-thing`; the type once keyed `thing`. */
@route("/renamed/{thing-id}")
@get
op renamedHeader(
  @path("thing-id") thingId: string,

  @header("x-thing") thing: string,

  @query("$select") select?: string,
): Thing;

/** A raw binary body. The validator emits none; the type once said `string` whatever it was served as. */
@route("/raw")
@post
op rawBytes(
  @header contentType: "application/octet-stream",

  @body body: bytes,
): Thing;

/** An ordinary JSON body, so the arm is not measuring only the odd cases. */
@route("/plain")
@post
op plainBody(@body body: Thing): Thing;
