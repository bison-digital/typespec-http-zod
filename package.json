{
	"name": "typespec-http-zod",
	"version": "0.17.0",
	"description": "TypeSpec emitter and library: turn an HTTP service definition into Zod validators and framework-free contract types that agree, keyword for keyword, with the OpenAPI document @typespec/openapi3 publishes from the same source.",
	"keywords": [
		"codegen",
		"json-schema",
		"openapi",
		"typespec",
		"typespec-emitter",
		"validation",
		"zod"
	],
	"homepage": "https://github.com/bison-digital/typespec-http-zod#readme",
	"bugs": {
		"url": "https://github.com/bison-digital/typespec-http-zod/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bison-digital/typespec-http-zod.git"
	},
	"files": [
		"lib/*.tsp",
		"dist/**",
		"!dist/test/**"
	],
	"type": "module",
	"main": "dist/src/index.js",
	"exports": {
		".": {
			"typespec": "./lib/main.tsp",
			"types": "./dist/src/index.d.ts",
			"default": "./dist/src/index.js"
		},
		"./runtime": {
			"types": "./dist/src/runtime.d.ts",
			"default": "./dist/src/runtime.js"
		}
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"test": "tsc -p tsconfig.build.json && vitest run",
		"typecheck": "tsc -p tsconfig.json",
		"lint": "oxlint src/ test/",
		"format": "oxfmt",
		"format:check": "oxfmt --check"
	},
	"devDependencies": {
		"@types/node": "^26.0.0",
		"@typespec/compiler": "1.15.0",
		"@typespec/events": "0.85.0",
		"@typespec/http": "1.15.0",
		"@typespec/http-specs": "0.1.0-alpha.41",
		"@typespec/openapi": "1.15.0",
		"@typespec/openapi3": "1.15.0",
		"@typespec/rest": "0.85.0",
		"@typespec/sse": "0.85.0",
		"@typespec/streams": "0.85.0",
		"@typespec/versioning": "0.85.0",
		"@typespec/xml": "0.85.0",
		"oxfmt": "^0.63.0",
		"oxlint": "^1.78.0",
		"typescript": "~7.0.2",
		"typespec-http-zod": "link:.",
		"vitest": "^4.1.9",
		"yaml": "^2.9.0",
		"zod": "^4.4.3"
	},
	"peerDependencies": {
		"@typespec/compiler": "^1.15.0",
		"@typespec/http": "^1.15.0",
		"@typespec/openapi": "^1.15.0",
		"@typespec/streams": "^0.85.0",
		"@typespec/versioning": "^0.85.0",
		"zod": "^4.0.0"
	},
	"peerDependenciesMeta": {
		"@typespec/streams": {
			"optional": true
		},
		"@typespec/versioning": {
			"optional": true
		}
	},
	"engines": {
		"node": ">=22.0.0"
	},
	"packageManager": "pnpm@11.21.0",
	"tspMain": "lib/main.tsp"
}
